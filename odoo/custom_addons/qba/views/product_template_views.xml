<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================================
         1. Kế Thừa Form View: Bổ Sung Mã OE Bảng Editable, Ảnh Phụ, Mô Tả Nội Bộ, Scale x3
         ====================================================================== -->
    <record id="product_template_qba_form_view" model="ir.ui.view">
        <field name="name">product.template.qba.form</field>
        <field name="model">product.template</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Cờ kiểm tra Admin ẩn để điều khiển quyền sửa -->
            <xpath expr="//sheet" position="before">
                <field name="is_system_admin" invisible="1"/>
            </xpath>

            <!-- Mở khóa Theo dõi hàng tồn kho cho Admin -->
            <xpath expr="//field[@name='is_storable']" position="attributes">
                <attribute name="readonly">not is_system_admin</attribute>
            </xpath>

            <!-- Ảnh đại diện: Rê chuột phóng to scale x3 + Thumbnail ảnh phụ đính kèm (Hover Scale x4) bên dưới -->
            <field name="image_1920" position="replace">
                <div class="float-end d-flex flex-column align-items-center me-2 mb-2" style="max-width: 280px; overflow: visible !important; position: relative; z-index: 50;">
                    <field
                        name="image_1920"
                        widget="image"
                        class="oe_avatar qba-form-avatar-zoom m-0"
                        options="{'convert_to_webp': False}"
                    />
                    <div class="qba-attachment-strip-wrapper w-100 mt-2" style="overflow: visible !important;">
                        <field name="attachment_images_preview" nolabel="1"/>
                    </div>
                </div>
            </field>

            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="is_website_linked" invisible="1"/>
                <button name="action_open_website_url"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-globe">
                    <div class="o_stat_info">
                        <span class="o_stat_text text-success fw-bold" invisible="not is_website_linked">
                            <i class="fa fa-check-circle me-1"/>Trên Web
                        </span>
                        <span class="o_stat_text text-muted" invisible="is_website_linked">
                            <i class="fa fa-chain me-1"/>Chưa Link
                        </span>
                        <span class="o_stat_text small text-secondary">Website SEO</span>
                    </div>
                </button>
                <button name="action_view_extra_images"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-picture-o">
                    <field name="extra_image_count" widget="statinfo" string="Tập tin / Ảnh"/>
                </button>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_open_web_link_wizard"
                        type="object"
                        string="Link Web SEO"
                        class="btn-outline-primary"
                        icon="fa-globe"/>
                <button name="action_open_ai_assistant"
                        type="object"
                        string="Cách Lấy Thông Số SP (AI)"
                        class="btn-info"
                        icon="fa-magic"/>
                <button name="action_open_compare_wizard"
                        type="object"
                        string="So Sánh Sản Phẩm"
                        class="btn-secondary"
                        icon="fa-columns"/>
                <button name="open_label_wizard"
                        type="object"
                        string="Tạo Tem"
                        class="btn-primary"
                        icon="fa-barcode"/>
            </xpath>

            <!-- Cột phải: Bảng OE. Code thay thế SKU thương hiệu + Thông số phụ -->
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="brand_id"/>
                <label for="oe_code_ids" string="OE. Code"/>
                <div class="oe_title">
                    <field name="oe_code_ids" widget="one2many" nolabel="1">
                        <list editable="bottom" string="Danh sách mã OE">
                            <field name="name" string="OE. Code" placeholder="Nhập mã OE..."/>
                            <field name="brand_id" optional="show" string="Hãng"/>
                            <field name="note" optional="show" string="Ghi chú"/>
                        </list>
                    </field>
                </div>
                <label for="warranty_days" string="Bảo hành"/>
                <div class="o_row">
                    <field name="warranty_days" class="oe_inline"/>
                    <span>ngày</span>
                    <span invisible="not warranty" class="text-muted small ms-2">(<field name="warranty" class="oe_inline" readonly="1" nolabel="1"/>)</span>
                </div>
                <field name="technical_specs" string="Mô tả SP" placeholder="Kích thước, thông số kỹ thuật, mô tả chi tiết sản phẩm..."/>
                <field name="axle_info" placeholder="Ví dụ: HOWO công nghệ MAN; Cầu láp 13T"/>
                <field name="label_image" widget="image"/>
            </xpath>

            <xpath expr="//notebook" position="inside">

                <!-- Tab Thông Tin Lịch Sử Kho & Giá -->
                <page string="Lịch Sử Kho &amp; Giá">
                    <group>
                        <group string="Lịch Sử Nhập Hàng">
                            <field name="last_purchase_code" readonly="1"/>
                            <field name="last_purchase_date" readonly="1"/>
                        </group>
                        <group string="Lịch Sử Báo Giá">
                            <field name="last_quotation_code" readonly="1"/>
                            <field name="last_quotation_date" readonly="1"/>
                        </group>
                    </group>
                </page>

                <!-- Cây phân cấp Xe / Động cơ / Hộp số / Cầu (như Danh mục sản phẩm từ gốc đến ngọn) -->
                <page string="Xe">
                    <field name="vehicle_ids">
                        <list editable="bottom" string="Dòng xe áp dụng">
                            <field name="complete_name" string="Dòng xe"/>
                        </list>
                    </field>
                </page>
                <page string="Động cơ">
                    <field name="engine_ids">
                        <list editable="bottom" string="Động cơ áp dụng">
                            <field name="complete_name" string="Động cơ"/>
                        </list>
                    </field>
                </page>
                <page string="Hộp số">
                    <field name="gearbox_ids">
                        <list editable="bottom" string="Hộp số áp dụng">
                            <field name="complete_name" string="Hộp số"/>
                        </list>
                    </field>
                </page>
                <page string="Cầu">
                    <field name="axle_ids">
                        <list editable="bottom" string="Cầu xe áp dụng">
                            <field name="complete_name" string="Cầu xe"/>
                        </list>
                    </field>
                </page>

                <!-- Tab Liên Kết Website SEO -->
                <page string="Website SEO" name="website_seo">
                    <group>
                        <group string="Thông Tin Liên Kết Website (phutungotoquyba.com)">
                            <field name="is_website_linked" widget="boolean_toggle" readonly="1"/>
                            <field name="website_product_url" widget="url" placeholder="https://phutungotoquyba.com/products/slug-id"/>
                            <field name="website_product_id" readonly="1"/>
                            <field name="website_product_slug" readonly="1"/>
                            <field name="website_link_date" readonly="1"/>
                        </group>
                        <group string="Thao Tác Nhanh">
                            <div class="d-flex flex-column gap-2 pt-2">
                                <button name="action_open_web_link_wizard"
                                        type="object"
                                        string="Tìm Kiếm &amp; Chọn Từ Website"
                                        class="btn btn-outline-primary"
                                        icon="fa-search"/>
                                <button name="action_open_website_url"
                                        type="object"
                                        string="Mở Xem Trên Website Công Khai"
                                        class="btn btn-outline-success"
                                        icon="fa-external-link"
                                        invisible="not is_website_linked"/>
                                <button name="action_unlink_website"
                                        type="object"
                                        string="Hủy Liên Kết Website"
                                        class="btn btn-outline-danger"
                                        icon="fa-chain-broken"
                                        invisible="not is_website_linked"
                                        confirm="Bạn có chắc chắn muốn gỡ liên kết website cho sản phẩm này không?"/>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ======================================================================
         2. Kế Thừa Tree / List View
         ====================================================================== -->
    <record id="product_template_qba_tree_view" model="ir.ui.view">
        <field name="name">product.template.qba.list</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="class" add="qba-list-product-name" separator=" "/>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="before">
                <field name="image_128" widget="image" class="oe_avatar qba-lightbox-trigger" string="Ảnh" optional="show" options="{'size': [36, 36]}"/>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="oe_codes_display" optional="show" string="Mã OE"/>
                <field name="brand_id" optional="show"/>
                <field name="warranty" optional="hide" string="Bảo hành"/>
                <field name="technical_specs" optional="show" string="Mô tả SP"/>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="qty_available" optional="show"/>
                <field name="is_website_linked" optional="show" string="Web SEO" widget="boolean"/>
                <field name="website_product_url" optional="hide" widget="url" string="Link Web"/>
                <field name="last_purchase_code" optional="show" string="Toa nhập gần nhất"/>
                <field name="last_quotation_code" optional="hide" string="Toa báo giá gần nhất"/>
                <field name="extra_image_count" optional="hide" string="Tập tin / Ảnh"/>
            </xpath>
        </field>
    </record>

    <!-- ======================================================================
         3. Kế Thừa Search View
         ====================================================================== -->
    <record id="product_template_qba_search_view" model="ir.ui.view">
        <field name="name">product.template.qba.search</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="oe_codes_display" string="Mã OE" filter_domain="['|', ('oe_codes_display', 'ilike', self), ('oe_code_ids.name', 'ilike', self)]"/>
                <field name="brand_id" string="Thương hiệu"/>
                <field name="technical_specs" string="Mô tả SP"/>
            </xpath>
            <xpath expr="//filter[@name='filter_to_sell']" position="before">
                <filter string="Có mã OE" name="filter_has_oe_code" domain="[('oe_code_ids', '!=', False)]"/>
                <filter string="Hàng sẵn trong kho" name="filter_in_stock" domain="[('qty_available', '&gt;', 0)]"/>
                <separator/>
                <filter string="Đã liên kết Web" name="filter_website_linked" domain="[('is_website_linked', '=', True)]"/>
                <filter string="Chưa liên kết Web" name="filter_not_website_linked" domain="[('is_website_linked', '=', False)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- ======================================================================
         4. Kế Thừa Kanban View: Siêu Tinh Gọn, Mật Độ Hiển Thị Cao (8-9 SP/màn hình)
         ====================================================================== -->
    <record id="product_template_qba_kanban_view" model="ir.ui.view">
        <field name="name">product.template.qba.kanban</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="class" add="qba-product-kanban-view" separator=" "/>
            </xpath>
            <xpath expr="//kanban" position="inside">
                <field name="oe_codes_display"/>
                <field name="warranty"/>
                <field name="warranty_days"/>
                <field name="technical_specs"/>
                <field name="axle_info"/>
                <field name="vehicles_display"/>
                <field name="engines_display"/>
                <field name="gearboxes_display"/>
                <field name="axles_display"/>
                <field name="extra_image_count"/>
                <field name="last_purchase_date"/>
                <field name="last_purchase_code"/>
                <field name="last_quotation_date"/>
                <field name="last_quotation_code"/>
                <field name="brand_id"/>
                <field name="categ_id"/>
                <field name="vehicle_ids"/>
                <field name="engine_ids"/>
                <field name="gearbox_ids"/>
                <field name="axle_ids"/>
                <field name="qty_available"/>
                <field name="uom_id"/>
                <field name="internal_notes"/>
                <field name="image_512"/>
                <field name="is_website_linked"/>
                <field name="website_product_url"/>
            </xpath>
            <xpath expr="//t[@t-name='card']" position="replace">
                <t t-name="card" class="qba-product-card d-flex flex-row align-items-start w-100 py-2" t-att-data-product-id="record.id.raw_value" t-att-data-extra-count="record.extra_image_count.raw_value">
                    <!-- CỘT TRÁI: Ảnh sản phẩm 72x72px gọn gàng, hover zoom HD, click xem toàn bộ album ảnh -->
                    <div class="qba-img-hover-box position-relative d-flex align-items-center justify-content-center me-3 flex-shrink-0 mt-1"
                         t-att-data-product-id="record.id.raw_value"
                         t-att-data-extra-count="record.extra_image_count.raw_value">
                        <field name="image_512" widget="image" class="qba-img-hover-scale rounded border object-fit-contain bg-white w-100 h-100"/>
                        <span t-if="record.extra_image_count.value &gt; 0"
                              class="qba-extra-badge"
                              t-att-data-product-id="record.id.raw_value"
                              title="Click để xem toàn bộ ảnh của sản phẩm">
                            +<t t-esc="record.extra_image_count.value"/>
                        </span>
                    </div>

                    <!-- THÂN THẺ SẢN PHẨM: Chia 3 khu vực song song tận dụng tối đa chiều ngang -->
                    <div class="qba-product-card-body">
                        <!-- KHU VỰC 1 (TRÁI): Tên SP, Kích thước (dưới tên), Brand + Bảo hành, Mã OE -->
                        <div class="qba-product-main-col">
                            <!-- Dòng 1: [Mã SKU] Tên sản phẩm -->
                            <div class="d-flex align-items-start qba-product-title-box">
                                <field class="me-1 flex-shrink-0 mt-1" name="is_favorite" widget="boolean_favorite" nolabel="1"/>
                                <span class="fw-bold text-dark qba-product-title">
                                    <span t-if="record.default_code.value" class="text-primary me-1">[<field name="default_code"/>]</span>
                                    <field name="name"/>
                                </span>
                            </div>

                            <!-- Dòng 2: Mô tả SP / Kích thước (Technical Specs) nằm dưới tên -->
                            <div t-if="record.technical_specs.value" class="qba-tech-specs-line text-dark fw-medium small pt-1" style="font-size: 0.8rem; line-height: 1.35; color: #1e293b !important;" title="Mô tả sản phẩm">
                                <field name="technical_specs"/>
                            </div>

                            <!-- Dòng 3: [Web SEO] + [Thương hiệu] + [Bảo hành] -->
                            <div class="d-flex align-items-center flex-wrap gap-2 pt-1">
                                <span t-if="record.is_website_linked.raw_value" class="qba-web-badge" title="Đã có bài viết trên Website SEO">
                                    <i class="fa fa-globe me-1" title="Website SEO"/>Web SEO
                                </span>
                                <span t-if="record.brand_id.value" class="badge bg-light text-danger border px-2 py-0 font-monospace fw-bold" style="border-radius: 4px; font-size: 0.78rem;">
                                    [<field name="brand_id"/>]
                                </span>
                                <span t-if="record.warranty_days.raw_value &gt; 0" class="badge bg-light text-primary border px-2 py-0 fw-semibold" style="border-radius: 4px; font-size: 0.75rem;" title="Thời gian bảo hành">
                                    <i class="fa fa-shield me-1"/>Bảo hành <t t-esc="record.warranty_days.raw_value"/> ngày
                                </span>
                                <span t-elif="record.warranty.value and record.warranty.value != 'Không bảo hành'" class="badge bg-light text-primary border px-2 py-0 fw-semibold" style="border-radius: 4px; font-size: 0.75rem;" title="Thời gian bảo hành">
                                    <i class="fa fa-shield me-1"/><field name="warranty"/>
                                </span>
                            </div>

                            <!-- Dòng 4: Mã OE (Đa mã OE, ngăn cách bởi |) -->
                            <div t-if="record.oe_codes_display.value" class="pt-1 w-100" style="max-width: 100%;">
                                <span class="qba-oe-badge" style="font-size: 0.78rem;">
                                    <span class="text-secondary fw-semibold me-1">OE:</span><field name="oe_codes_display"/>
                                </span>
                            </div>
                        </div>

                        <!-- KHU VỰC 2 (GIỮA): Dư địa còn rộng -> 4 dòng riêng biệt cho Áp dụng ([Xe], [Động cơ], [Hộp số], [Cầu]) -->
                        <div class="qba-product-compat-col">
                            <div t-if="record.vehicles_display.value" class="qba-compat-line">
                                <span class="qba-compat-tag">[Xe]</span>
                                <span class="qba-compat-colon">:</span>
                                <span class="qba-compat-val"><t t-esc="record.vehicles_display.value"/></span>
                            </div>
                            <div t-if="record.engines_display.value" class="qba-compat-line">
                                <span class="qba-compat-tag">[Động cơ]</span>
                                <span class="qba-compat-colon">:</span>
                                <span class="qba-compat-val"><t t-esc="record.engines_display.value"/></span>
                            </div>
                            <div t-if="record.gearboxes_display.value" class="qba-compat-line">
                                <span class="qba-compat-tag">[Hộp số]</span>
                                <span class="qba-compat-colon">:</span>
                                <span class="qba-compat-val"><t t-esc="record.gearboxes_display.value"/></span>
                            </div>
                            <div t-if="record.axles_display.value or record.axle_info.value" class="qba-compat-line">
                                <span class="qba-compat-tag">[Cầu]</span>
                                <span class="qba-compat-colon">:</span>
                                <span class="qba-compat-val"><t t-esc="record.axles_display.value or record.axle_info.value"/></span>
                            </div>
                            <!-- Nếu sản phẩm chưa có dữ liệu tương thích trong CSDL -->
                            <div t-if="!record.vehicles_display.value and !record.engines_display.value and !record.gearboxes_display.value and !record.axles_display.value and !record.axle_info.value" class="text-muted small fst-italic py-1" style="font-size: 0.76rem;" title="Sản phẩm chưa được gán thông số xe áp dụng">
                                <span class="text-muted opacity-75"><i class="fa fa-info-circle me-1"/>Chưa cập nhật dòng xe</span>
                            </div>
                        </div>

                        <!-- KHU VỰC 3 (PHẢI): Giá bán (to, đỏ), SL tồn kho, Danh mục, Lịch sử mua/báo giá, Nút So sánh -->
                        <div class="qba-product-meta-col">
                            <!-- Hàng 1: Giá bán (đỏ to, bên trái) + Tồn kho (bên phải) -->
                            <div class="d-flex align-items-center justify-content-between w-100 flex-nowrap">
                                <div class="fw-bold text-danger flex-shrink-0" style="font-size: 1.15rem; line-height: 1.2;">
                                    <field name="list_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </div>
                                <div class="qba-stock-pill flex-shrink-0 ms-auto">
                                    SL: <field name="qty_available"/> <field name="uom_id"/>
                                </div>
                            </div>

                            <!-- Hàng 2: Danh mục sản phẩm (thẳng hàng từ trái qua phải) -->
                            <div class="text-muted small text-truncate w-100 text-start" style="font-size: 0.76rem;" title="Danh mục">
                                <i class="fa fa-folder-o me-1 text-secondary"/><field name="categ_id"/>
                            </div>

                            <!-- Hàng 3: Toa nhập gần nhất (thẳng hàng từ trái qua phải) -->
                            <div t-if="record.last_purchase_code.value" class="text-start text-truncate w-100 small" style="font-size: 0.74rem;" title="Toa nhập gần nhất">
                                <span class="text-success fw-semibold">
                                    <i class="fa fa-calendar-check-o me-1"/><field name="last_purchase_code"/>
                                </span>
                            </div>

                            <!-- Hàng 4: Toa báo giá gần nhất (bên trái) & Nút So sánh (bên phải) -->
                            <div class="d-flex align-items-center justify-content-between gap-1 mt-1 w-100 flex-nowrap">
                                <span t-if="record.last_quotation_code.value" class="text-truncate fw-semibold small text-nowrap text-start flex-grow-1" style="font-size: 0.74rem; color: #0284c7; min-width: 0;" title="Toa báo giá gần nhất">
                                    <i class="fa fa-clock-o me-1" style="color: #0284c7;"/><field name="last_quotation_code"/>
                                </span>
                                <span t-else="" class="flex-grow-1"/>
                                <button name="action_open_compare_wizard"
                                        type="object"
                                        class="btn btn-sm btn-outline-secondary py-0 px-2 fw-normal flex-shrink-0 text-nowrap ms-auto"
                                        style="font-size: 0.74rem; line-height: 1.3;"
                                        title="So sánh chi tiết sản phẩm">
                                    <i class="fa fa-columns me-1"/>So sánh
                                </button>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
