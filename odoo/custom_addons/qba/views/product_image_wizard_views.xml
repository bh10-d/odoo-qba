<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qba_product_image_wizard_form" model="ir.ui.view">
        <field name="name">qba.product.image.wizard.form</field>
        <field name="model">qba.product.image.wizard</field>
        <field name="arch" type="xml">
            <form string="Tải Lên Nhiều Ảnh Sản Phẩm">
                <group>
                    <field name="product_tmpl_id" readonly="1" options="{'no_open': True}"/>
                    <field name="attachment_ids" widget="many2many_binary" string="Chọn các tệp ảnh"/>
                </group>
                <div class="alert alert-info py-2" role="alert">
                    <i class="fa fa-info-circle me-1" title="Thông tin"/>
                    <strong>Mẹo tải ảnh:</strong> Bạn có thể nhấn giữ phím <b>Ctrl</b> hoặc <b>Shift</b> để chọn cùng lúc nhiều file ảnh từ máy tính (hỗ trợ JPG, PNG, WebP) hoặc kéo thả trực tiếp danh sách ảnh vào ô trên.
                </div>
                <footer>
                    <button name="action_upload_images" string="Lưu &amp; Thêm Ảnh Vào Sản Phẩm" type="object" class="btn-primary" icon="fa-upload"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

