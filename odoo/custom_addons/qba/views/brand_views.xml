<odoo>
    <record id="view_qba_brand_list" model="ir.ui.view">
        <field name="name">qba.brand.list</field>
        <field name="model">qba.brand</field>
        <field name="arch" type="xml">
            <list string="Thương hiệu">
                <field name="name" string="Tên thương hiệu"/>
                <field name="product_count" string="Số sản phẩm"/>
            </list>
        </field>
    </record>

    <record id="view_qba_brand_form" model="ir.ui.view">
        <field name="name">qba.brand.form</field>
        <field name="model">qba.brand</field>
        <field name="arch" type="xml">
            <form string="Thương hiệu">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-th-list">
                            <field name="product_count" widget="statinfo" string="Sản phẩm"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Tên thương hiệu"/>
                        <h1>
                            <field name="name" placeholder="Ví dụ: HYUNDAI, HOWO, ANTEK, CREATEK..."/>
                        </h1>
                    </div>
                    <div class="alert alert-light border small text-muted my-2 py-2 px-3 d-flex align-items-center" role="status">
                        <i class="fa fa-info-circle text-primary me-2 fa-lg"/>
                        <span>Nhập tên thương hiệu (ví dụ: <b>HoWo</b>, <b>Hyundai</b>, <b>Createk</b>, <b>Dongfeng</b>...) và nhấn <b>Enter</b> để tự động tra cứu toàn bộ sản phẩm liên quan theo tên, dòng xe và mã OE.</span>
                    </div>
                    <notebook>
                        <page string="Danh sách sản phẩm" name="products">
                            <field name="product_ids" readonly="1">
                                <list string="Sản phẩm" decoration-muted="not active">
                                    <field name="image_128" widget="image" options="{'size': [36, 36]}" string="Ảnh" optional="show"/>
                                    <field name="default_code" string="Mã SKU"/>
                                    <field name="name" string="Tên sản phẩm"/>
                                    <field name="oe_codes_display" string="Mã OE" optional="show"/>
                                    <field name="list_price" string="Giá bán" widget="monetary" optional="show"/>
                                    <field name="qty_available" string="Tồn kho" optional="show"/>
                                    <field name="uom_id" string="ĐVT" optional="show"/>
                                    <field name="last_purchase_code" string="Toa nhập gần nhất" optional="show"/>
                                    <field name="active" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_qba_brand_search" model="ir.ui.view">
        <field name="name">qba.brand.search</field>
        <field name="model">qba.brand</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Thương hiệu">
                <field name="name" string="Tên thương hiệu"/>
            </search>
        </field>
    </record>

    <record id="action_qba_brand" model="ir.actions.act_window">
        <field name="name">Thương hiệu</field>
        <field name="res_model">qba.brand</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qba_brand_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo thương hiệu phụ tùng mới
            </p>
        </field>
    </record>

    <menuitem id="menu_qba_brand"
              name="Thương hiệu"
              parent="sale.product_menu_catalog"
              action="action_qba_brand"
              sequence="101"/>

    <menuitem id="menu_qba_brand_purchase"
              name="Thương hiệu"
              parent="purchase.menu_purchase_products"
              action="action_qba_brand"
              sequence="101"/>

    <menuitem id="menu_qba_brand_stock"
              name="Thương hiệu"
              parent="stock.menu_stock_inventory_control"
              action="action_qba_brand"
              sequence="101"/>
</odoo>
