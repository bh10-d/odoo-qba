<odoo>
    <record id="view_qba_gearbox_list" model="ir.ui.view">
        <field name="name">qba.gearbox.list</field>
        <field name="model">qba.gearbox</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name" string="Hộp số"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="product_count" string="Số sản phẩm"/>
                <field name="brand" optional="hide"/>
                <field name="category" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_qba_gearbox_form" model="ir.ui.view">
        <field name="name">qba.gearbox.form</field>
        <field name="model">qba.gearbox</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Sản phẩm"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Mã hộp số / Cấp phân loại"/>
                        <h1><field name="name" placeholder="Ví dụ: Fast, 9JS135, 12JSD200..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id" placeholder="Chọn danh mục cha (VD: Fast / 9JS135)"/>
                            <field name="brand"/>
                            <field name="ratio"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="vehicle_models"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <div class="qba-fullwidth-category-form row g-4 mt-2 mb-3">
                        <div class="col-12 col-lg-7">
                            <div class="fw-bold mb-2" style="font-size: 0.95rem; color: #5b21b6;">Mô tả hộp số</div>
                            <div class="qba-category-desc-box">
                                <field name="description" nolabel="1" class="qba-category-html-desc" placeholder="Nhập thông tin mô tả kỹ thuật, thông số hoặc lưu ý của hộp số..."/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-5">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold" style="font-size: 0.95rem; color: #b91c1c;">Hình ảnh hộp số</span>
                                <span class="text-muted small" style="font-size: 0.76rem;"><i class="fa fa-search-plus me-1"/>Click vào ảnh để phóng to</span>
                            </div>
                            <div class="qba-category-image-box text-center">
                                <field name="image_1920" widget="image" nolabel="1" class="qba-category-large-img qba-lightbox-trigger"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_qba_gearbox" model="ir.actions.act_window">
        <field name="name">Hộp số</field>
        <field name="res_model">qba.gearbox</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_qba_gearbox"
              name="Hộp số"
              parent="sale.product_menu_catalog"
              action="action_qba_gearbox"
              sequence="104"/>

    <menuitem id="menu_qba_gearbox_purchase"
              name="Hộp số"
              parent="purchase.menu_purchase_products"
              action="action_qba_gearbox"
              sequence="104"/>

    <menuitem id="menu_qba_gearbox_stock"
              name="Hộp số"
              parent="stock.menu_stock_inventory_control"
              action="action_qba_gearbox"
              sequence="104"/>
</odoo>
