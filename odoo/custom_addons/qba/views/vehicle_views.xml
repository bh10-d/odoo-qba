<odoo>
    <record id="view_qba_vehicle_list" model="ir.ui.view">
        <field name="name">qba.vehicle.list</field>
        <field name="model">qba.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name" string="Dòng xe (Cây phân cấp mẹ / con)"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="product_count" string="Số sản phẩm"/>
                <field name="brand" optional="hide"/>
                <field name="category" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_qba_vehicle_form" model="ir.ui.view">
        <field name="name">qba.vehicle.form</field>
        <field name="model">qba.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Sản phẩm"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Tên xe / Cấp phân loại"/>
                        <h1><field name="name" placeholder="Ví dụ: Thaco, OLLIN, 2015, xe ben..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id" placeholder="Chọn danh mục cha (VD: Thaco / OLLIN / 2015)"/>
                            <field name="brand"/>
                            <field name="model_code"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="year"/>
                            <field name="engine_id"/>
                            <field name="gearbox_id"/>
                            <field name="axle"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_qba_vehicle" model="ir.actions.act_window">
        <field name="name">Xe</field>
        <field name="res_model">qba.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_qba_vehicle"
              name="Xe"
              parent="sale.product_menu_catalog"
              action="action_qba_vehicle"
              sequence="102"/>
</odoo>
