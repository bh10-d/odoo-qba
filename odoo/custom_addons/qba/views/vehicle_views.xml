<odoo>
    <record id="view_qba_vehicle_list" model="ir.ui.view">
        <field name="name">qba.vehicle.list</field>
        <field name="model">qba.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Dòng xe"/>
                <field name="parent_id" string="Danh mục chính"/>
                <field name="product_count" string="Số sản phẩm"/>
                <field name="brand" string="Hãng xe"/>
                <field name="category" string="Chủng loại"/>
                <field name="extra_image_count" string="Ảnh phụ" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_qba_vehicle_form" model="ir.ui.view">
        <field name="name">qba.vehicle.form</field>
        <field name="model">qba.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Sản phẩm"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Tên xe / Cấp phân loại"/>
                        <h1><field name="name" placeholder="Ví dụ: Thaco, OLLIN, 2015, xe ben..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id" string="Danh mục chính" placeholder="Chọn danh mục chính (VD: Thaco / OLLIN / 2015)"/>
                            <field name="brand"/>
                            <field name="model_code"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="year"/>
                            <field name="engine_id"/>
                            <field name="gearbox_id"/>
                            <field name="axle"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <div class="qba-fullwidth-category-form row g-4 mt-2 mb-3">
                        <div class="col-12 col-lg-7">
                            <div class="fw-bold mb-2" style="font-size: 0.95rem; color: #5b21b6;">Mô tả dòng xe</div>
                            <div class="qba-category-desc-box">
                                <field name="description" nolabel="1" class="qba-category-html-desc" placeholder="Nhập thông tin mô tả kỹ thuật, hướng dẫn nhận diện hoặc lưu ý của dòng xe..."/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-5">
                            <div class="d-flex align-items-center justify-content-between mb-1 pb-1 border-bottom">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="fw-bold text-dark" style="font-size: 0.9rem;">
                                        <i class="fa fa-camera text-primary me-1"/>Hình ảnh xe
                                    </span>
                                    <field name="extra_image_count" invisible="1"/>
                                    <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle ms-1"
                                          invisible="extra_image_count == 0" style="font-size: 0.72rem; padding: 2px 7px;">
                                        <i class="fa fa-images me-1"/>+<field name="extra_image_count" readonly="1"/> ảnh
                                    </span>
                                </div>
                                <span class="text-muted small" style="font-size: 0.72rem;">
                                    <i class="fa fa-search-plus me-1 text-secondary"/>Phóng to
                                </span>
                            </div>
                            <div class="qba-category-image-box text-center position-relative">
                                <field name="image_1920" widget="image" nolabel="1" class="qba-category-large-img qba-lightbox-trigger"/>
                            </div>
                            <div class="qba-extra-images-panel mt-2 p-2 bg-light rounded border">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="small fw-semibold text-secondary" style="font-size: 0.78rem;">
                                        <i class="fa fa-paperclip text-primary me-1"/>Ảnh phụ đính kèm
                                    </span>
                                    <span class="text-muted" style="font-size: 0.7rem;">(chọn nhiều ảnh cùng lúc)</span>
                                </div>
                                <field name="extra_image_ids" widget="many2many_binary" string="Tải ảnh phụ" class="qba-compact-uploader" options="{'accepted_file_extensions': 'image/*'}"/>
                                <field name="attachment_images_preview" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_qba_vehicle" model="ir.actions.act_window">
        <field name="name">Xe</field>
        <field name="res_model">qba.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_qba_vehicle"
              name="Xe"
              parent="sale.product_menu_catalog"
              action="action_qba_vehicle"
              sequence="102"/>

    <menuitem id="menu_qba_vehicle_purchase"
              name="Xe"
              parent="purchase.menu_purchase_products"
              action="action_qba_vehicle"
              sequence="102"/>

    <menuitem id="menu_qba_vehicle_stock"
              name="Xe"
              parent="stock.menu_stock_inventory_control"
              action="action_qba_vehicle"
              sequence="102"/>
</odoo>
