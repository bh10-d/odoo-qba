<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Giao diện Wizard Cập nhật Thuộc tính Hàng loạt (Dành riêng cho Admin) -->
    <record id="view_qba_product_bulk_edit_wizard_form" model="ir.ui.view">
        <field name="name">qba.product.bulk.edit.wizard.form</field>
        <field name="model">qba.product.bulk.edit.wizard</field>
        <field name="arch" type="xml">
            <form string="Cập nhật thuộc tính sản phẩm hàng loạt (Admin)">
                <sheet>
                    <field name="filter_domain_repr" invisible="1"/>
                    <field name="selected_count" invisible="1"/>
                    <field name="total_filter_count" invisible="1"/>

                    <!-- Khung cảnh báo & hướng dẫn nghiệp vụ -->
                    <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
                        <i class="fa fa-shield fa-2x me-3 text-primary" title="Đặc quyền Admin"/>
                        <div>
                            <div class="fw-bold fs-6">Đặc quyền Quản trị viên (Admin) - Chỉnh sửa thuộc tính sản phẩm:</div>
                            <div class="mt-1">
                                Số lượng sản phẩm sẽ áp dụng: 
                                <strong class="text-danger fs-5"><field name="product_count" readonly="1"/></strong> sản phẩm.
                            </div>
                        </div>
                    </div>

                    <!-- Tùy chọn phạm vi: Chỉ các sản phẩm đang chọn HOẶC Toàn bộ theo bộ lọc -->
                    <div class="card p-3 mb-3 bg-light border-0 shadow-sm" invisible="not filter_domain_repr or selected_count == 0">
                        <label for="scope" class="fw-bold text-dark mb-2" string="Chọn phạm vi áp dụng:"/>
                        <field name="scope" widget="radio" options="{'horizontal': true}"/>
                    </div>

                    <!-- Bảng cấu hình thuộc tính cần thay đổi -->
                    <div class="row g-3">
                        <!-- Nhóm 1: Theo dõi hàng tồn kho -->
                        <div class="col-12 col-md-6">
                            <div class="card h-100 shadow-sm border-0 bg-light p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <field name="change_is_storable" widget="boolean" class="me-2"/>
                                    <label for="change_is_storable" class="fw-bold text-dark m-0" string="1. Thay đổi Theo dõi tồn kho"/>
                                </div>
                                <div invisible="not change_is_storable" class="ps-4 border-start border-primary border-2 mt-2">
                                    <div class="d-flex align-items-center my-1">
                                        <field name="is_storable" widget="boolean" class="me-2"/>
                                        <label for="is_storable" class="fw-semibold m-0" string="Theo dõi hàng tồn kho"/>
                                    </div>
                                    <div class="alert alert-warning border border-warning rounded p-2 mt-2 mb-0">
                                        <div class="fw-bold text-dark"><i class="fa fa-exclamation-triangle text-warning me-1"/> LƯU Ý KHO VẬN QUAN TRỌNG:</div>
                                        <ul class="mb-0 mt-1 small ps-3">
                                            <li>Khi bật <strong>"Theo dõi hàng tồn kho"</strong>, Odoo bắt đầu theo dõi thẻ kho. Số tồn ban đầu hiển thị trên hệ thống sẽ là <strong>0</strong> (không tự tính dồn phiếu cũ).</li>
                                            <li><strong class="text-danger">BẮT BUỘC:</strong> Sau khi áp dụng, Kế toán/Thủ kho phải thực hiện <strong>"Cập nhật số lượng"</strong> hoặc làm phiếu <strong>Kiểm kê kho</strong> để khớp đúng số tồn thực tế trên kệ!</li>
                                            <li>Chuyển đổi này <strong>an toàn 100% cho Sổ cái Kế toán</strong> và không làm thay đổi các chứng từ nhập/xuất trong quá khứ.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Nhóm 2: Điểm bán hàng (POS) -->
                        <div class="col-12 col-md-6">
                            <div class="card h-100 shadow-sm border-0 bg-light p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <field name="change_available_in_pos" widget="boolean" class="me-2"/>
                                    <label for="change_available_in_pos" class="fw-bold text-dark m-0" string="2. Thay đổi Bán trên POS"/>
                                </div>
                                <div invisible="not change_available_in_pos" class="ps-4 border-start border-success border-2 mt-2">
                                    <div class="d-flex align-items-center my-1">
                                        <field name="available_in_pos" widget="boolean" class="me-2"/>
                                        <label for="available_in_pos" class="fw-semibold m-0" string="Bán trên Điểm bán hàng (POS)"/>
                                    </div>
                                    <div class="form-text small text-muted">
                                        <i class="fa fa-shopping-cart text-success me-1"/>
                                        Hiển thị sản phẩm trên màn hình thu ngân POS để thực hiện mua bán lẻ nhanh.
                                    </div>

                                    <div class="mt-2 pt-2 border-top">
                                        <div class="d-flex align-items-center mb-1">
                                            <field name="change_pos_categ" widget="boolean" class="me-2"/>
                                            <label for="change_pos_categ" class="m-0 small fw-bold" string="Gán phân loại POS"/>
                                        </div>
                                        <div invisible="not change_pos_categ">
                                            <field name="pos_categ_ids" widget="many2many_tags" placeholder="Chọn danh mục POS..."/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Nhóm 3: Đơn vị tính -->
                        <div class="col-12 col-md-6">
                            <div class="card h-100 shadow-sm border-0 bg-light p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <field name="change_uom" widget="boolean" class="me-2"/>
                                    <label for="change_uom" class="fw-bold text-dark m-0" string="3. Thay đổi Đơn vị tính"/>
                                </div>
                                <div invisible="not change_uom" class="ps-4 border-start border-warning border-2 mt-2">
                                    <div class="mb-2">
                                        <label for="uom_id" class="small fw-semibold" string="Đơn vị tính mới:"/>
                                        <field name="uom_id" options="{'no_create': True}" placeholder="Chọn đơn vị tính..."/>
                                    </div>
                                    <div class="d-flex align-items-center my-1">
                                        <field name="sync_uom_po" widget="boolean" class="me-2"/>
                                        <label for="sync_uom_po" class="small m-0" string="Đồng bộ ĐVT mua hàng (uom_po_id)"/>
                                    </div>
                                    <div class="alert alert-danger border border-danger rounded p-2 mt-2 mb-0">
                                        <div class="fw-bold text-danger"><i class="fa fa-ban me-1"/> CẢNH BÁO NGUY HIỂM CAO - ĐỔI ĐƠN VỊ TÍNH:</div>
                                        <ul class="mb-0 mt-1 small ps-3">
                                            <li>Chỉ đổi khi kế toán tạo nhầm tên ĐVT và thực tế quy đổi tương đương (ví dụ nhầm "Cái" thành "Chiếc").</li>
                                            <li>Hệ thống <strong>nghiêm cấm</strong> đổi sang nhóm ĐVT khác (như Cái sang Kg/Lít) với sản phẩm đã có phiếu kho.</li>
                                            <li>Nếu đổi sang đơn vị có tỷ lệ khác (như Cái sang Thùng), số lượng và giá vốn quá khứ có thể bị sai tỷ lệ. <strong>Bắt buộc kiểm kê lại tồn kho và kiểm tra lại giá bán/giá vốn!</strong></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Nhóm 4: Trạng thái Bán & Mua -->
                        <div class="col-12 col-md-6">
                            <div class="card h-100 shadow-sm border-0 bg-light p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="fw-bold text-dark m-0">4. Trạng thái Bán &amp; Mua</span>
                                </div>
                                <div class="ps-4 border-start border-secondary border-2">
                                    <div class="d-flex align-items-center my-1">
                                        <field name="change_sale_ok" widget="boolean" class="me-2"/>
                                        <label for="change_sale_ok" class="small m-0 me-3" string="Đổi trạng thái Bán:"/>
                                        <span invisible="not change_sale_ok">
                                            <field name="sale_ok" widget="boolean" class="me-1"/>
                                            <label for="sale_ok" class="small fw-semibold m-0" string="Có thể bán"/>
                                        </span>
                                    </div>
                                    <div class="d-flex align-items-center my-1 pt-1">
                                        <field name="change_purchase_ok" widget="boolean" class="me-2"/>
                                        <label for="change_purchase_ok" class="small m-0 me-3" string="Đổi trạng thái Mua:"/>
                                        <span invisible="not change_purchase_ok">
                                            <field name="purchase_ok" widget="boolean" class="me-1"/>
                                            <label for="purchase_ok" class="small fw-semibold m-0" string="Có thể mua"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Khung chốt an toàn bắt buộc xác nhận rủi ro khi đổi Tồn kho hoặc ĐVT -->
                    <div invisible="not change_is_storable and not change_uom" class="alert alert-danger border-2 border-danger shadow-sm mt-3 p-3">
                        <div class="d-flex align-items-start">
                            <field name="confirm_risk" widget="boolean" class="me-3 mt-1"/>
                            <div>
                                <label for="confirm_risk" class="fw-bold text-danger fs-6 mb-1 d-block" string="XÁC NHẬN RỦI RO &amp; TRÁCH NHIỆM (BẮT BUỘC):"/>
                                <div class="small text-dark">
                                    Tôi xác nhận là <strong>Quản trị viên (Admin)</strong>. Tôi đã đọc và hiểu rõ các cảnh báo nghiệp vụ:
                                    <br/>
                                    1. <strong>Về Tồn kho:</strong> Số tồn ban đầu hiển thị sẽ là <strong>0</strong> và bộ phận kho bắt buộc phải cập nhật/kiểm kê lại số lượng thực tế.
                                    <br/>
                                    2. <strong>Về Đơn vị tính:</strong> Việc đổi ĐVT có thể ảnh hưởng đến tỷ lệ số lượng quá khứ nếu khác quy cách đóng gói.
                                    <br/>
                                    Tôi xác nhận chịu trách nhiệm khi thực hiện cập nhật này.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Danh sách các sản phẩm đang được chọn xem trước (Khi scope == 'selected') -->
                    <div invisible="scope != 'selected'" class="mt-4">
                        <label for="product_tmpl_ids" class="fw-bold fs-6 mb-2" string="Danh sách sản phẩm đang chọn:"/>
                        <field name="product_tmpl_ids" readonly="1">
                            <list limit="10">
                                <field name="default_code" string="Mã SKU" class="font-monospace fw-bold"/>
                                <field name="name" string="Tên sản phẩm"/>
                                <field name="is_storable" string="Theo dõi kho" widget="boolean"/>
                                <field name="available_in_pos" string="Bán POS" widget="boolean"/>
                                <field name="uom_id" string="Đơn vị tính"/>
                                <field name="qty_available" string="Tồn thực tế"/>
                            </list>
                        </field>
                    </div>

                    <!-- Thông báo khi chọn TOÀN BỘ sản phẩm (Khi scope == 'all') -->
                    <div invisible="scope != 'all'" class="mt-4">
                        <div class="alert alert-warning d-flex align-items-center">
                            <i class="fa fa-exclamation-triangle fa-2x me-3 text-warning"/>
                            <div>
                                <strong>Lưu ý:</strong> Bạn đang chọn áp dụng cho <strong>TOÀN BỘ <field name="total_filter_count" readonly="1" class="fw-bold text-danger"/> sản phẩm</strong> theo bộ lọc hiện tại. Khi nhấn <em>"Áp dụng thay đổi"</em>, hệ thống sẽ cập nhật tự động toàn bộ danh sách này trên máy chủ.
                            </div>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply"
                            string="Áp dụng thay đổi (Admin)"
                            type="object"
                            class="btn-primary"
                            icon="fa-check"/>
                    <button string="Hủy bỏ"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 2. Server Action gán vào menu Hành động (Action) trong danh sách Sản phẩm (List View) -->
    <record id="action_server_bulk_edit_products" model="ir.actions.server">
        <field name="name">Chỉnh sửa thuộc tính sản phẩm (Admin)</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">
action = records.action_open_bulk_edit_wizard()
        </field>
    </record>
</odoo>
