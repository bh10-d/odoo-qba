<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qba_product_web_link_wizard_form" model="ir.ui.view">
        <field name="name">qba.product.web.link.wizard.form</field>
        <field name="model">qba.product.web.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Liên Kết Sản Phẩm Với Website SEO">
                <sheet>
                    <!-- THÔNG TIN SẢN PHẨM GỐC TỪ ODOO (MASTER DATA) -->
                    <div class="alert alert-primary mb-3 py-2 px-3 shadow-sm border" role="alert">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div>
                                <span class="badge bg-primary text-uppercase me-2">Sản phẩm gốc Odoo</span>
                                <span class="fw-bold fs-6 text-dark">
                                    <span class="text-primary me-1" invisible="not product_code">[<field name="product_code" readonly="1" class="oe_inline"/>]</span>
                                    <field name="product_name" readonly="1" class="oe_inline"/>
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-3 small">
                                <div>
                                    <span class="text-muted">Tồn kho Odoo: </span>
                                    <span class="badge bg-success-subtle text-success border fw-bold"><field name="product_qty" readonly="1"/></span>
                                </div>
                                <div>
                                    <span class="text-muted">Giá bán: </span>
                                    <span class="fw-bold text-danger"><field name="product_price" widget="monetary" readonly="1"/></span>
                                </div>
                            </div>
                        </div>
                        <div class="small text-muted mt-1 pt-1 border-top" invisible="not product_oe_codes">
                            <span>Mã OE / Part No gốc: </span>
                            <span class="font-monospace fw-semibold text-secondary"><field name="product_oe_codes" readonly="1"/></span>
                        </div>
                    </div>

                    <field name="product_tmpl_id" invisible="1"/>

                    <!-- PHƯƠNG ÁN 1: TRA CỨU & GỢI Ý TỪ WEBSITE QUA API -->
                    <div class="card mb-3 border shadow-sm">
                        <div class="card-header bg-light py-2 fw-bold text-dark d-flex align-items-center justify-content-between">
                            <span><i class="fa fa-search me-2 text-info" title="Tìm kiếm"/>Cách 1: Tra cứu &amp; Ghép nối bài viết từ Website SEO</span>
                            <span class="badge bg-info text-white">Khuyên dùng</span>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-2 align-items-center mb-2">
                                <div class="col-md-9">
                                    <field name="search_query"
                                           placeholder="Nhập mã phụ tùng, mã SKU hoặc tên để tìm bài viết trên web..."
                                           class="form-control"/>
                                </div>
                                <div class="col-md-3">
                                    <button name="action_search_web"
                                            type="object"
                                            string="Tra Cứu Web"
                                            class="btn btn-info text-white w-100 fw-bold"
                                            icon="fa-search"/>
                                </div>
                            </div>

                            <!-- Nút bấm tìm nhanh theo dữ liệu Odoo -->
                            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap small">
                                <span class="text-muted">Tìm nhanh:</span>
                                <button name="action_search_by_code"
                                        type="object"
                                        string="Theo Mã SKU Odoo"
                                        class="btn btn-xs btn-outline-secondary py-0 px-2"
                                        icon="fa-tag"/>
                                <button name="action_search_by_oe"
                                        type="object"
                                        string="Theo Mã OE / Part No"
                                        class="btn btn-xs btn-outline-secondary py-0 px-2"
                                        icon="fa-barcode"/>
                                <button name="action_search_by_name"
                                        type="object"
                                        string="Theo Tên Sản Phẩm"
                                        class="btn btn-xs btn-outline-secondary py-0 px-2"
                                        icon="fa-font"/>
                                <button name="action_test_connection"
                                        type="object"
                                        string="Kiểm tra kết nối API"
                                        class="btn btn-xs btn-outline-info py-0 px-2 ms-auto"
                                        icon="fa-refresh"/>
                            </div>

                            <!-- Thông báo trạng thái kết nối nổi bật, rõ ràng -->
                            <field name="api_status_state" invisible="1"/>
                            <div invisible="not api_status_message" class="mb-3">
                                <div invisible="api_status_state != 'success'" class="alert alert-success border-success py-2 px-3 fw-bold text-success d-flex align-items-center shadow-sm" role="status">
                                    <i class="fa fa-check-circle fa-lg me-2 text-success" title="Thành công"/>
                                    <field name="api_status_message" readonly="1" class="d-inline text-success"/>
                                </div>
                                <div invisible="api_status_state != 'warning'" class="alert alert-warning border-warning py-2 px-3 fw-bold text-dark d-flex align-items-center shadow-sm" role="status">
                                    <i class="fa fa-exclamation-triangle fa-lg me-2 text-warning" title="Cảnh báo"/>
                                    <field name="api_status_message" readonly="1" class="d-inline text-dark"/>
                                </div>
                                <div invisible="api_status_state != 'danger'" class="alert alert-danger border-danger py-2 px-3 fw-bold text-danger d-flex align-items-center shadow-sm" role="alert">
                                    <i class="fa fa-times-circle fa-lg me-2 text-danger" title="Lỗi"/>
                                    <field name="api_status_message" readonly="1" class="d-inline text-danger"/>
                                </div>
                                <div invisible="api_status_state not in ('info', False)" class="alert alert-info border-info py-2 px-3 fw-semibold text-info d-flex align-items-center shadow-sm" role="status">
                                    <i class="fa fa-info-circle fa-lg me-2 text-info" title="Thông tin"/>
                                    <field name="api_status_message" readonly="1" class="d-inline text-info"/>
                                </div>
                            </div>

                            <!-- Bảng kết quả bài viết tìm được trên Web -->
                            <field name="candidate_ids" mode="list" nolabel="1">
                                <list string="Kết quả tìm thấy trên Web" create="false" delete="false" edit="false">
                                    <field name="web_id" string="ID Web" optional="show"/>
                                    <field name="name" string="Tên bài viết trên Web"/>
                                    <field name="part_number" string="Part Number" optional="show"/>
                                    <field name="internal_code" string="Mã Web" optional="show"/>
                                    <field name="price" string="Giá niêm yết" widget="monetary" optional="show"/>
                                    <field name="is_odoo_linked" string="Đã nối Odoo" widget="boolean" optional="show"/>
                                    <button name="action_choose_candidate"
                                            type="object"
                                            string="Chọn Liên Kết"
                                            class="btn-sm btn-success fw-bold"
                                            icon="fa-link"/>
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- PHƯƠNG ÁN 2: DÁN ĐƯỜNG LINK TRỰC TIẾP (URL) -->
                    <div class="card mb-3 border shadow-sm">
                        <div class="card-header bg-light py-2 fw-bold text-dark d-flex align-items-center justify-content-between">
                            <span><i class="fa fa-link me-2 text-primary" title="Đường link"/>Cách 2: Gắn đường link trực tiếp (URL)</span>
                            <span class="badge bg-secondary">Dán link thủ công</span>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-2 align-items-center">
                                <div class="col-md-9">
                                    <field name="target_url"
                                           placeholder="Dán link web: https://phutungotoquyba.com/products/slug-id hoặc http://localhost:3000/products/15"
                                           class="form-control"/>
                                </div>
                                <div class="col-md-3">
                                    <button name="action_confirm_link"
                                            type="object"
                                            string="Lưu Liên Kết"
                                            class="btn btn-primary w-100 fw-bold"
                                            icon="fa-check"/>
                                </div>
                            </div>
                            <div class="row g-2 mt-2 pt-2 border-top small text-muted">
                                <div class="col-md-4">
                                    <span>ID Web nhận diện: </span>
                                    <span class="fw-bold text-dark"><field name="web_product_id" readonly="1"/></span>
                                </div>
                                <div class="col-md-4">
                                    <span>Slug nhận diện: </span>
                                    <span class="fw-bold text-dark"><field name="web_product_slug" readonly="1"/></span>
                                </div>
                                <div class="col-md-4 text-end">
                                    <field name="sync_to_web"/>
                                    <label for="sync_to_web" class="ms-1 small fw-normal"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CẤU HÌNH KẾT NỐI API & WEBSITE (TIỆN ÍCH) -->
                    <div class="card border-0 bg-light p-2 rounded small text-muted">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-3">
                                <div>
                                    <span class="fw-semibold">API Backend: </span>
                                    <field name="api_url" class="oe_inline font-monospace" placeholder="http://host.docker.internal:5000/api/v1"/>
                                </div>
                                <div>
                                    <span class="fw-semibold">Web Public: </span>
                                    <field name="site_url" class="oe_inline font-monospace" placeholder="http://localhost:3000"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>

                <footer>
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <div>
                            <button name="action_unlink"
                                    type="object"
                                    string="Hủy Liên Kết Web"
                                    class="btn btn-outline-danger"
                                    icon="fa-chain-broken"
                                    confirm="Bạn có chắc chắn muốn gỡ bỏ liên kết website cho sản phẩm này không?"/>
                        </div>
                        <div>
                            <button string="Đóng" class="btn btn-secondary" special="cancel"/>
                        </div>
                    </div>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_qba_product_web_link_wizard" model="ir.actions.act_window">
        <field name="name">Liên Kết Website SEO</field>
        <field name="res_model">qba.product.web.link.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
