<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_qba_warranty" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.qba.warranty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='price_subtotal']" position="before">
                <field name="warranty_days" optional="show" string="BH (ngày)"/>
                <field name="warranty_end_date" optional="show" string="Hạn BH"/>
            </xpath>
        </field>
    </record>
</odoo>

