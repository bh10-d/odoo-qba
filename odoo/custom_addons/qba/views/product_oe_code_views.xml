<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view cho qba.product.oe_code -->
    <record id="view_qba_product_oe_code_list" model="ir.ui.view">
        <field name="name">qba.product.oe_code.list</field>
        <field name="model">qba.product.oe_code</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" placeholder="Ví dụ: 080V02511-0721"/>
                <field name="brand_id"/>
                <field name="note" placeholder="Vị trí / Đời xe áp dụng..."/>
            </list>
        </field>
    </record>

    <!-- List view cho qba.product.image -->
    <record id="view_qba_product_image_list" model="ir.ui.view">
        <field name="name">qba.product.image.list</field>
        <field name="model">qba.product.image</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="image_128" widget="image" options="{'size': [64, 64]}"/>
                <field name="name" placeholder="Mô tả ảnh..."/>
                <field name="image_1920" filename="name"/>
            </list>
        </field>
    </record>

    <!-- Kanban view cho qba.product.image -->
    <record id="view_qba_product_image_kanban" model="ir.ui.view">
        <field name="name">qba.product.image.kanban</field>
        <field name="model">qba.product.image</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="image_1920"/>
                <templates>
                    <t t-name="card" class="p-2 border rounded m-1 text-center" style="width: 140px;">
                        <div class="o_kanban_image mb-1">
                            <field name="image_1920" widget="image" options="{'img_class': 'img-fluid rounded', 'preview_image': 'image_128'}"/>
                        </div>
                        <div class="small text-truncate">
                            <field name="name"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
