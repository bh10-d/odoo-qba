<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view cho qba.product.oe_code -->
    <record id="view_qba_product_oe_code_list" model="ir.ui.view">
        <field name="name">qba.product.oe_code.list</field>
        <field name="model">qba.product.oe_code</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" placeholder="Ví dụ: 080V02511-0721"/>
                <field name="brand_id"/>
                <field name="note" placeholder="Vị trí / Đời xe áp dụng..."/>
            </list>
        </field>
    </record>

    <!-- Form view cho qba.product.image -->
    <record id="view_qba_product_image_form" model="ir.ui.view">
        <field name="name">qba.product.image.form</field>
        <field name="model">qba.product.image</field>
        <field name="arch" type="xml">
            <form string="Hình Ảnh Sản Phẩm">
                <sheet>
                    <div class="row align-items-center">
                        <div class="col-md-7">
                            <group>
                                <field name="name" placeholder="Ví dụ: Mặt nghiêng, Tem thông số, Mặt bích..."/>
                                <field name="sequence"/>
                                <field name="product_tmpl_id" invisible="1"/>
                            </group>
                        </div>
                        <div class="col-md-5 text-center">
                            <label for="image_1920" string="Tải hình ảnh lên"/><br/>
                            <field name="image_1920" widget="image" class="oe_avatar border rounded p-1" options="{'preview_image': 'image_128', 'size': [200, 200]}"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view cho qba.product.image -->
    <record id="view_qba_product_image_list" model="ir.ui.view">
        <field name="name">qba.product.image.list</field>
        <field name="model">qba.product.image</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="image_1920" widget="image" options="{'size': [64, 64]}"/>
                <field name="name" placeholder="Mô tả ảnh..."/>
                <field name="product_tmpl_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Kanban view cho qba.product.image -->
    <record id="view_qba_product_image_kanban" model="ir.ui.view">
        <field name="name">qba.product.image.kanban</field>
        <field name="model">qba.product.image</field>
        <field name="arch" type="xml">
            <kanban default_order="sequence">
                <field name="id"/>
                <field name="name"/>
                <field name="sequence" widget="handle"/>
                <templates>
                    <t t-name="card" class="p-2 border rounded m-1 text-center position-relative shadow-sm bg-white" style="width: 150px;">
                        <div class="o_kanban_image mb-2 d-flex align-items-center justify-content-center" style="height: 110px; overflow: hidden; background: #fbfbfb; border-radius: 6px;">
                            <field name="image_1920" widget="image" class="w-100 h-100 object-fit-contain qba-lightbox-trigger" options="{'preview_image': 'image_128'}"/>
                        </div>
                        <div class="small fw-semibold text-truncate text-dark px-1" t-att-title="record.name.value">
                            <field name="name"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
