<odoo>
    <record id="view_qba_engine_list" model="ir.ui.view">
        <field name="name">qba.engine.list</field>
        <field name="model">qba.engine</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name" string="Động cơ (Cây phân cấp mẹ / con)"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="product_count" string="Số sản phẩm"/>
                <field name="brand" optional="hide"/>
                <field name="capacity" optional="hide"/>
                <field name="horsepower" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_qba_engine_form" model="ir.ui.view">
        <field name="name">qba.engine.form</field>
        <field name="model">qba.engine</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Sản phẩm"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Tên động cơ / Cấp phân loại"/>
                        <h1><field name="name" placeholder="Ví dụ: Weichai, WP12, WP12.375N..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id" placeholder="Chọn danh mục cha (VD: Weichai / WP12)"/>
                            <field name="brand"/>
                            <field name="capacity"/>
                            <field name="horsepower"/>
                        </group>
                        <group>
                            <field name="torque"/>
                            <field name="emission_standard"/>
                            <field name="category"/>
                            <field name="vehicle_models"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_qba_engine" model="ir.actions.act_window">
        <field name="name">Động cơ</field>
        <field name="res_model">qba.engine</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_qba_engine"
              name="Động cơ"
              parent="sale.product_menu_catalog"
              action="action_qba_engine"
              sequence="103"/>

    <menuitem id="menu_qba_engine_purchase"
              name="Động cơ"
              parent="purchase.menu_purchase_products"
              action="action_qba_engine"
              sequence="103"/>

    <menuitem id="menu_qba_engine_stock"
              name="Động cơ"
              parent="stock.menu_stock_inventory_control"
              action="action_qba_engine"
              sequence="103"/>
</odoo>
