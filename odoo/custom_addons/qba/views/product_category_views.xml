<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_view_inherit_qba" model="ir.ui.view">
        <field name="name">product.category.form.inherit.qba</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <!-- Thay the nut xem san pham cu thanh action xem danh sach san pham chuan -->
            <xpath expr="//div[@name='button_box']/button" position="replace">
                <button class="oe_stat_button" name="action_view_products" icon="fa-cubes" type="object">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="product_count"/></span>
                        <span class="o_stat_text"> Sản phẩm</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
