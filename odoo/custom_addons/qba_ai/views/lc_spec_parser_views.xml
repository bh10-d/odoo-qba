<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View Wizard Xem Trước & Áp Dụng Parser -->
    <record id="view_qba_lc_spec_parser_wizard_form" model="ir.ui.view">
        <field name="name">qba.lc.spec.parser.wizard.form</field>
        <field name="model">qba.lc.spec.parser.wizard</field>
        <field name="arch" type="xml">
            <form string="Trích Xuất Thông Số Kỹ Thuật LC (AI Parser)">
                <header>
                    <button name="action_apply_proposals"
                            type="object"
                            string="Áp dụng đề xuất hợp lệ (Tạo bản nháp)"
                            icon="fa-check-circle"
                            class="btn-primary"
                            groups="qba_ai.group_qba_ai_manager"
                            confirm="Hệ thống sẽ tạo các thông số kỹ thuật mới ở trạng thái 'Chưa kiểm duyệt' (unverified) để Quản trị viên kiểm tra. Không ghi đè bất kỳ dữ liệu nào đã xác thực. Bạn có chắc chắn muốn tiếp tục?"/>
                    <button name="action_parse_preview"
                            type="object"
                            string="Phân tích lại"
                            icon="fa-refresh"
                            class="btn-secondary"
                            groups="qba_ai.group_qba_ai_manager"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2>Trích Xuất Thông Số Kỹ Thuật Danh Mục LC (Lá Côn)</h2>
                        <p class="text-muted">
                            Hệ thống tự động phân tích tên phụ tùng để trích xuất: Đường kính ngoài (phi), Số răng (R), Kích thước Moay ơ C &amp; D, và Số lò xo.
                            <b>Chế độ xem trước (Preview) an toàn 100%, không ghi đè dữ liệu cho đến khi Quản trị viên xác nhận.</b>
                        </p>
                    </div>

                    <group>
                        <group>
                            <field name="category_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="product_ids" widget="many2many_tags" placeholder="Tất cả sản phẩm thuộc danh mục LC"/>
                        </group>
                    </group>

                    <!-- Thống kê phân tích -->
                    <div class="row g-2 mb-3 text-center">
                        <div class="col">
                            <div class="p-2 border rounded bg-light">
                                <div class="fs-4 fw-bold text-primary"><field name="total_products"/></div>
                                <div class="small text-muted">Sản phẩm quét</div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="p-2 border rounded bg-light">
                                <div class="fs-4 fw-bold text-success"><field name="total_draft_ready"/></div>
                                <div class="small text-muted">Sẵn sàng tạo nháp</div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="p-2 border rounded bg-light">
                                <div class="fs-4 fw-bold text-danger"><field name="total_conflicts"/></div>
                                <div class="small text-muted">Xung đột / Cần xem xét</div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="p-2 border rounded bg-light">
                                <div class="fs-4 fw-bold text-muted"><field name="total_skipped"/></div>
                                <div class="small text-muted">Bỏ qua / Đã có</div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="p-2 border rounded bg-light">
                                <div class="fs-4 fw-bold text-warning"><field name="total_missing"/></div>
                                <div class="small text-muted">Thiếu trong tên</div>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Bảng Chi Tiết Đề Xuất Thông Số" name="proposals_table">
                            <field name="line_ids">
                                <list editable="bottom"
                                      decoration-success="proposed_action == 'create_draft'"
                                      decoration-danger="parsing_status == 'conflict'"
                                      decoration-warning="parsing_status == 'ambiguous' or proposed_action == 'manual_review'"
                                      decoration-muted="proposed_action == 'skip'">
                                    <field name="selected" widget="boolean_toggle" string="Áp dụng"/>
                                    <field name="product_code" string="Mã SP" readonly="1"/>
                                    <field name="product_name" string="Tên sản phẩm" readonly="1"/>
                                    <field name="spec_definition_id" string="Thông số" readonly="1"/>
                                    <field name="proposed_value" string="Giá trị đề xuất" class="fw-bold text-primary"/>
                                    <field name="uom" string="Đơn vị" readonly="1"/>
                                    <field name="source_pattern" string="Cú pháp nguồn" readonly="1"/>
                                    <field name="existing_value" string="Giá trị hiện tại" readonly="1"/>
                                    <field name="existing_status" string="Trạng thái hiện tại" readonly="1"/>
                                    <field name="parsing_status" widget="badge"
                                           decoration-success="parsing_status in ('confident', 'match')"
                                           decoration-danger="parsing_status == 'conflict'"
                                           decoration-warning="parsing_status in ('missing', 'ambiguous')"/>
                                    <field name="proposed_action" widget="badge"
                                           decoration-success="proposed_action == 'create_draft'"
                                           decoration-danger="proposed_action == 'manual_review'"
                                           decoration-muted="proposed_action == 'skip'"/>
                                    <field name="notes" string="Giải thích / Lý do" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action Mở Wizard -->
    <record id="action_qba_lc_spec_parser_wizard" model="ir.actions.act_window">
        <field name="name">Trích Xuất Thông Số Tên LC</field>
        <field name="res_model">qba.lc.spec.parser.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>

