<odoo>
    <!-- List View Hàng Chờ Admin Duyệt -->
    <record id="view_qba_ai_approval_queue_tree" model="ir.ui.view">
        <field name="name">qba.ai.approval.queue.tree</field>
        <field name="model">qba.ai.approval.queue</field>
        <field name="arch" type="xml">
            <list string="Hàng Chờ Admin Duyệt" decoration-warning="state=='pending'" decoration-success="state=='approved'" decoration-muted="state=='rejected'">
                <field name="create_date" string="Thời gian"/>
                <field name="name"/>
                <field name="reason"/>
                <field name="state" widget="badge" decoration-warning="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
                <field name="reviewer_id"/>
            </list>
        </field>
    </record>

    <!-- Form View Hàng Chờ Admin Duyệt -->
    <record id="view_qba_ai_approval_queue_form" model="ir.ui.view">
        <field name="name">qba.ai.approval.queue.form</field>
        <field name="model">qba.ai.approval.queue</field>
        <field name="arch" type="xml">
            <form string="Chi Tiết Phê Duyệt AI">
                <header>
                    <button name="action_approve" string="Chấp Thuận &amp; Lưu Vào Kiến Thức" type="object" class="btn-success" invisible="state != 'pending'"/>
                    <button name="action_reject" string="Từ Chối" type="object" class="btn-secondary" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Tiêu đề yêu cầu"/>
                        <h1>
                            <field name="name" readonly="state != 'pending'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="reason" readonly="state != 'pending'"/>
                            <field name="create_date" string="Ngày tạo" readonly="1"/>
                        </group>
                        <group>
                            <field name="reviewer_id" readonly="1"/>
                            <field name="created_knowledge_id" readonly="1" invisible="not created_knowledge_id"/>
                        </group>
                    </group>
                    <group string="Câu hỏi từ nhân viên">
                        <field name="question" nolabel="1" readonly="state != 'pending'"/>
                    </group>
                    <group string="Câu trả lời / Nội dung kiến thức bổ sung">
                        <field name="suggested_answer" nolabel="1" placeholder="Admin nhập câu trả lời chuẩn xác hoặc chỉnh sửa câu trả lời từ AI trước khi bấm Duyệt..." readonly="state != 'pending'"/>
                    </group>
                    <group string="Ghi chú người duyệt">
                        <field name="review_notes" nolabel="1" placeholder="Ghi chú lý do duyệt hoặc từ chối..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_qba_ai_approval_queue" model="ir.actions.act_window">
        <field name="name">Hàng Chờ Admin Phê Duyệt Kiến Thức</field>
        <field name="res_model">qba.ai.approval.queue</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
