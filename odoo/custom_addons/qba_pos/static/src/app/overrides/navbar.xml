<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-centerheader')]//img[hasclass('pos-logo')]" position="replace">
            <img class="pos-logo mw-100" height="42" t-on-click="() => debug.toggleWidget()" src="/qba_pos/static/src/img/logo.png" alt="QBA Logo" style="cursor: pointer; object-fit: contain;" />
        </xpath>
    </t>
</templates>

