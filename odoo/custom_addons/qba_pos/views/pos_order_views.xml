<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_qba_pos" model="ir.ui.view">
        <field name="name">pos.order.form.qba.pos</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <!-- Stat button tin nhan Zalo -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_zalo_messages"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-comments"
                        invisible="zalo_message_count == 0">
                    <field name="zalo_message_count" widget="statinfo" string="Tin Zalo"/>
                </button>
            </xpath>

            <!-- Hien thi cot Ten Hang / Quy Cach tuy chinh trong danh sach order lines -->
            <xpath expr="//field[@name='lines']/list/field[@name='full_product_name']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="string">Ten Hang / Quy Cach (Nhap Tay)</attribute>
            </xpath>

            <xpath expr="//field[@name='lines']/list/field[@name='product_id']" position="after">
                <field name="is_custom_manual_line" optional="show" widget="boolean_toggle" string="Hang Nhap Tay" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Ke thua List View Don Hang POS de them cot danh dau hang nhap tay -->
    <record id="view_pos_order_tree_qba_pos" model="ir.ui.view">
        <field name="name">pos.order.tree.qba.pos</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="has_custom_manual_products" string="Co SP Nhap Tay" optional="show" widget="boolean_toggle"/>
                <field name="zalo_message_count" string="Tin Zalo" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

